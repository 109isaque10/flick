<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource shrinking (isShrinkResources) strips resources that are only looked
  up by name at runtime. The splash video is resolved with
  Resources.getIdentifier(...), which the shrinker cannot see, so keep it.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/flick_splash,@raw/splash_video" />